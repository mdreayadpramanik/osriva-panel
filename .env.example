# OSRIVA Panel — Core API configuration (copy to .env and fill in).
# Never commit real values. Generate the secret key with:  osriva-api gen-secret

# production | development
OSRIVA_ENV=production

# Listen address. Keep it on loopback/internal networks; expose it only through the reverse proxy.
OSRIVA_HTTP_ADDR=127.0.0.1:8080

# PostgreSQL 16+ connection string. Use a dedicated role that owns only the OSRIVA database.
OSRIVA_DATABASE_URL=postgres://osriva:CHANGE_ME@127.0.0.1:5432/osriva?sslmode=disable

# Base64 of at least 32 random bytes. Encrypts secrets at rest (e.g. TOTP seeds) and
# derives CSRF keys. Back it up: losing it makes stored secrets unreadable.
OSRIVA_SECRET_KEY=

# Session cookie "Secure" flag. Defaults to true in production and must stay true there.
# OSRIVA_COOKIE_SECURE=true

# Session lifetime and idle timeout (Go durations).
# OSRIVA_SESSION_TTL=12h
# OSRIVA_SESSION_IDLE_TIMEOUT=2h
# Window after a password confirmation during which dangerous actions are allowed.
# OSRIVA_REAUTH_WINDOW=10m

# Comma-separated IPs/CIDRs of reverse proxies whose X-Forwarded-For is trusted.
# OSRIVA_TRUSTED_PROXIES=127.0.0.1,::1

# debug | info | warn | error ; json | text
# OSRIVA_LOG_LEVEL=info
# OSRIVA_LOG_FORMAT=json

# ---- Agent endpoint (Phase 2) ----
# All three are required for servers to enrol. The agent listener uses mutual TLS with
# the internal CA and must be reachable by agents DIRECTLY (not through Caddy).
# Open OSRIVA_AGENT_ADDR's port in your firewall yourself; OSRIVA never changes firewall rules.
# OSRIVA_PUBLIC_URL=https://panel.example.com
# OSRIVA_AGENT_ADDR=0.0.0.0:8443
# OSRIVA_AGENT_PUBLIC_URL=https://panel.example.com:8443

# ---- Development only (refused unless OSRIVA_ENV=development) ----
# In-memory store: no PostgreSQL needed, ALL DATA LOST ON RESTART.
# OSRIVA_DEV_MEMORY_STORE=true
# Seeds an owner into the in-memory store at startup.
# OSRIVA_DEV_ADMIN_EMAIL=dev@osriva.localhost
# OSRIVA_DEV_ADMIN_PASSWORD=

# ---- docker-compose.yml ----
# Password for the bundled PostgreSQL container.
POSTGRES_PASSWORD=
# Public hostname served by Caddy (enables automatic HTTPS for real domains).
OSRIVA_DOMAIN=localhost
# Agent enrolment in Compose: set all three (see "Agent endpoint" above), or leave all empty.
OSRIVA_PUBLIC_URL=
# e.g. https://panel.example.com / 0.0.0.0:8443 / https://panel.example.com:8443
OSRIVA_AGENT_ADDR=
OSRIVA_AGENT_PUBLIC_URL=
